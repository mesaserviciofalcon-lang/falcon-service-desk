generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Solicitud {
  id Int @id @default(autoincrement())

  tipo String

  solicitante String

  correoSolicitante String?

  estado String @default("Pendiente")

  asignadoA String?

  fechaCreacion DateTime @default(now())

  fechaCierre DateTime?

  observacionesTecnico String?

  gestionadoPor String?

  fechaGestion DateTime?

  gestiones GestionTicket[]

  archivos ArchivoAdjunto[]

  cctv SolicitudCCTV?

  visita SolicitudVisita?

  radio SolicitudRadio?

  antecedente SolicitudAntecedente?

  antecedentesRegistros AntecedenteRegistro[]

  novedad SeguridadNovedad?
}

model GestionTicket {
  id Int @id @default(autoincrement())

  solicitudId Int

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  usuario String

  estado String

  observacion String

  fecha DateTime @default(now())
}

model ArchivoAdjunto {
  id Int @id @default(autoincrement())

  solicitudId Int

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  nombre String

  ruta String

  tipo String

  createdAt DateTime @default(now())
}

model SolicitudCCTV {
  id Int @id @default(autoincrement())

  solicitudId Int @unique

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  fincaEAI String?

  camaraAfectada String?

  descripcionFalla String?

  prioridad String?

  observaciones String?
}

model SolicitudVisita {
  id Int @id @default(autoincrement())

  solicitudId Int @unique

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  nombreCandidato String?

  cedula String?

  fechaExpedicion String?

  telefono String?

  direccion String?

  municipio String?

  zona String?

  cargo String?

  fincaEAI String?

  motivoVisita String?

  fechaRealizada DateTime?

  observaciones String?

  resultadoVisita String?
}

model VisitaHistorica {
  id Int @id @default(autoincrement())

  fechaSolicitud String?

  fechaSolicitudDate DateTime?

  correoSolicitante String?

  solicitanteNombre String?

  nombresApellidos String?

  cedula String

  telefono String?

  direccion String?

  municipio String?

  zona String?

  motivoVisita String?

  cargo String?

  fincaEAI String?

  fechaExpedicionCedula String?

  fechaVisitaRealizada String?

  fechaVisitaDate DateTime?

  origenArchivo String?

  createdAt DateTime @default(now())

  @@index([cedula])
  @@index([fincaEAI])
  @@index([fechaVisitaDate])
}

model SolicitudRadio {
  id Int @id @default(autoincrement())

  solicitudId Int @unique

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  radio String?

  serial String?

  tipoFalla String?

  fincaEAI String?

  descripcion String?

  prioridad String?

  observaciones String?
}

model Usuario {
  id Int @id @default(autoincrement())

  nombre String

  email String @unique

  password String

  rol String

  cargo String?

  fincaEAI String?

  activo Boolean @default(true)

  debeCambiarPassword Boolean @default(false)

  fotoPerfilUrl String?

  createdAt DateTime @default(now())
}

model EquipoAdministrativo {
  id Int @id @default(autoincrement())

  nombres String

  apellidos String

  cargo String

  fotoUrl String

  createdAt DateTime @default(now())
}

model ActividadSupervisor {
  id Int @id @default(autoincrement())

  origenId String? @unique
  fechaPlaneada DateTime
  fechaPlaneadaFin DateTime?
  finca String
  actividad String
  area String?

  supervisorNombre String?
  supervisorCorreo String?
  estado String @default("PENDIENTE_ASIGNAR")

  observacionesCierre String?
  evidencias Json?
  fechaCierre DateTime?
  cumplidaEnFecha Boolean?
  cerradoPor String?
  cerradoPorCorreo String?

  creadoPor String?
  creadoPorCorreo String?
  recordatorioPrevioEnviadoAt DateTime?
  recordatorioIncumplimientoEnviadoAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  simulacro SimulacroActividad?

  @@index([fechaPlaneada])
  @@index([estado])
  @@index([supervisorCorreo])
}

model SimulacroActividad {
  id Int @id @default(autoincrement())
  actividadId Int @unique
  actividadSupervisor ActividadSupervisor @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  tipo String
  finca String
  area String?
  grupoObjeto String?
  personasInformadas String?
  escenario String?
  horaInicio String
  duracionMinutos Int?
  consecutivo String? @unique
  guion String
  resultado String
  cumplimientoObjetivo String
  desarrollo String
  pasos Json?
  aspectos Json
  promedioEvaluacion Float?
  sacSugerida String?
  conclusion String
  controlVulnerado String?
  razonIncumplimiento String?
  factoresFalla Json?
  requiereSac Boolean @default(false)
  evidencias Json?
  creadoPor String
  creadoPorCorreo String
  notificadoAt DateTime?
  recordatorioSacEnviadoAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitudAccion SolicitudAccion?

  @@index([finca])
  @@index([resultado])
}

model SolicitudAccion {
  id Int @id @default(autoincrement())
  simulacroId Int @unique
  simulacro SimulacroActividad @relation(fields: [simulacroId], references: [id], onDelete: Cascade)

  consecutivo String? @unique
  estado String @default("ABIERTA")
  tipoAccion String @default("Correctiva")
  proceso String @default("Seguridad")
  sistemaGestion String @default("Seguridad Física")
  norma String?
  requisito String?
  responsableProceso String?
  descripcionSituacion String
  correccion String?
  correcciones Json?
  analisisCausa String
  factoresCausa Json
  planAccion Json
  seguimiento Json?
  eficacia Boolean?
  seCierra Boolean?
  comentariosCierre String?
  analistaNombre String
  analistaCorreo String
  analisisRealizadoCargo String?
  fechaCierre DateTime?
  fechaReprogramacion DateTime?
  actividadReprogramadaId Int?
  recordatorioEnviadoAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([analistaCorreo])
}

model CatalogoActividad {
  id Int @id @default(autoincrement())
  tipo String
  valor String
  createdAt DateTime @default(now())

  @@unique([tipo, valor])
  @@index([tipo])
}

model SolicitudAntecedente {
  id Int @id @default(autoincrement())

  solicitudId Int @unique

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  fincaEAI String?

  observaciones String?

  prioridad String?
}

model AntecedenteRegistro {
  id Int @id @default(autoincrement())

  solicitudId Int

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  fechaSolicitud String?

  fechaRespuesta String?

  eai String?

  nombresApellidos String?

  tipoDocumento String?

  identificacion String

  fechaExpedicionDocumento String?

  observacion String?

  revisadoPor String?

  motivo String?

  autorizacion String?

  observaciones String?

  tusdatosBatchId String?

  tusdatosJobId String?

  tusdatosBatchNumber Int?

  tusdatosEstado String?

  tusdatosEnviadoAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([identificacion])
  @@index([eai])
  @@index([solicitudId])
  @@index([tusdatosBatchId])
}

model SeguridadNovedad {
  id Int @id @default(autoincrement())

  solicitudId Int @unique

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  fincaEAI String?

  contexto String?
}

model PasswordResetToken {
  id Int @id @default(autoincrement())

  email String

  token String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())
}

model VulnerabilidadInforme {
  id Int @id @default(autoincrement())

  consecutivo String?

  eai String

  fecha DateTime @default(now())

  actoInseguro String

  vulnerabilidad String

  planAccionSugerido String

  causaRaiz String?

  proceso String?

  planAccionEai String?

  responsables String?

  fechaEjecucion String?

  estado String @default("ABIERTO")

  supervisor String

  correoSupervisor String?

  reportadoPor String?

  analistaSigNombre String?

  analistaSigCorreo String?

  gerenteNombre String?

  gerenteCorreo String?

  copiaCorreos String?

  destinatarios String?

  fotos Json?

  cierreObservaciones String?

  cierreEvidencias Json?

  cerradoPor String?

  cerradoPorCorreo String?

  fechaCierre DateTime?

  createdAt DateTime @default(now())

  observacionesSeguimiento VulnerabilidadObservacion[]

  @@index([eai])
  @@index([consecutivo])
  @@index([estado])
  @@index([fecha])
}

model VulnerabilidadObservacion {
  id Int @id @default(autoincrement())

  informeId Int

  observacion String

  supervisor String

  usuarioNombre String?

  usuarioCorreo String?

  createdAt DateTime @default(now())

  informe VulnerabilidadInforme @relation(fields: [informeId], references: [id], onDelete: Cascade)

  @@index([informeId])
  @@index([createdAt])
}
